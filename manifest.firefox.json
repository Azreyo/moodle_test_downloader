{
  "manifest_version": 3,
  "name": "MTD - Moodle Test Downloader",
  "version": "1.2",
  "author": "Azreyo",
  "description": "Downloader for Moodle tests before teacher hides them",

  "icons": {
    "48": "icons/logo.svg"
  },

  "permissions": [
    "storage"
  ],

  "action": {
    "default_icon": "icons/logo.svg",
    "default_title": "MTD",
    "default_popup": "popup/menu.html"
  },

  "background": {
    "scripts": ["src/background.js"]
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/mtd.js"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["styles/stylizer.css"],
      "matches": ["<all_urls>"]
    }
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "mtd@moodle-test-downloader",
      "strict_min_version": "109.0"
    }
  }
}
